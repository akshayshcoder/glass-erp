{
  "name": "@glass-erp/database",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema, migrations and database-level tests for Glass ERP",
  "type": "module",
  "exports": {
    "./testing": {
      "types": "./tests/helpers.d.mts",
      "default": "./tests/helpers.mjs"
    }
  },
  "scripts": {
    "migrate": "node scripts/migrate.mjs",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=22"
  }
}
