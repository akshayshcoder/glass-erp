{
  "name": "glass-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Inventory, GST billing and accounting SaaS for glass, aluminium and hardware traders",
  "workspaces": [
    "database",
    "api",
    "web"
  ],
  "scripts": {
