# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Connect as a LOGIN role that is a member of erp_app (NOT a superuser, NOT erp_owner),
# otherwise row-level security and the permission model are bypassed. See README.
DATABASE_URL=postgres://erp_api:change-me@localhost:5432/glass_erp
DATABASE_POOL_SIZE=10

# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---- Production / security (see docs/03-operations.md) ----
# Proxies in front of the API whose X-Forwarded-For can be believed: false | 1 | 127.0.0.1,10.0.0.5
TRUST_PROXY=false
# Login cookie over HTTPS only. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=10
# Serve the built web app from the API (one port for everything): ../web/dist
# WEB_DIST_DIR=../web/dist
