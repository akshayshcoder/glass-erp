{
  "name": "@glass-erp/api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API for Glass ERP",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.0.2",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@glass-erp/database": "*",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "vitest": "^5.0.5"
  }
}
